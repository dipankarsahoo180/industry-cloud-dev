<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Automatic_Mode</name>
        <choiceText>Automatically</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Automatic</stringValue>
        </value>
    </choices>
    <choices>
        <name>Manual_Mode</name>
        <choiceText>Manually</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Manual</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Route_Application_Mode</name>
        <label>Route Application Mode</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Run_Customized</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Manually</defaultConnectorLabel>
        <rules>
            <name>Automatically_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Application_Mode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Automatic_Mode</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Run_Automatic</targetReference>
            </connector>
            <label>Automatically</label>
        </rules>
    </decisions>
    <description>Case Apply Care Plan entry point. Requires the user to choose automatic template expansion or a customized Care Plan with editable task suggestions.</description>
    <environments>Default</environments>
    <interviewLabel>Apply Care Plan Template {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Apply Care Plan Template</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Select_Application_Mode</name>
        <label>Apply Care Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Route_Application_Mode</targetReference>
        </connector>
        <fields>
            <name>Mode_Instructions</name>
            <fieldText>&lt;p&gt;Choose how to create the Care Plan. Automatic mode applies every configured template item. Manual mode lets you choose goals, benefits, and task definitions and edit or remove each suggested Task.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Application_Mode</name>
            <choiceReferences>Automatic_Mode</choiceReferences>
            <choiceReferences>Manual_Mode</choiceReferences>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Automatic_Mode</elementReference>
            </defaultValue>
            <fieldText>Creation Method</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Select_Application_Mode</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Run_Automatic</name>
        <label>Run Automatic Care Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Apply_Care_plan_Automatic</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>createdCarePlanId</assignToReference>
            <name>createdCarePlanId</name>
        </outputAssignments>
    </subflows>
    <subflows>
        <name>Run_Customized</name>
        <label>Run Customized Care Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>Apply_Care_plan_Customized</flowName>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>createdCarePlanId</assignToReference>
            <name>createdCarePlanId</name>
        </outputAssignments>
    </subflows>
    <variables>
        <name>createdCarePlanId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
