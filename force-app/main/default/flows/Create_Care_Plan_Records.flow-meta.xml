<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Build_Action_Plan</name>
        <label>Build Action Plan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.ActionPlanState</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.ActionPlanTemplateVersionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Resolve_Action_Plan_Versions.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.ActionPlanType</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Industries</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.EndDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Action_Plan_End_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Action_Plan_Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.StartDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Action_Plan_Start_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.StatusCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>NotStarted</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentActionPlan.TargetId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Care_Plan.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varActionPlansToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCurrentActionPlan</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varResolvedTemplateIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Resolve_Action_Plan_Versions.ActionPlanTemplateId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Resolve_Action_Plan_Versions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Build_Goal_Assignment</name>
        <label>Build Goal Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.CompletionPercentage</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.GoalAssigneeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case.ContactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.GoalDefinitionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Care_Plan_Goals.GoalDefinitionId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.ParentRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Care_Plan.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Care_Plan_Goals.Priority</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.StartDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Action_Plan_Start_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varCurrentGoalAssignment.TargetCompletionDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Action_Plan_End_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varGoalAssignmentsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCurrentGoalAssignment</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Capture_Goal_Action_Plan_Template_Id</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Capture_Goal_Action_Plan_Template_Id</name>
        <label>Capture Goal Action Plan Template Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCurrentTemplateId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Care_Plan_Goals.GoalDefinition.Action_Plan_Template__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varIsTemplateCollected</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Goal_Has_Action_Plan_Template</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Collect_Goal_Action_Plan_Template_Id</name>
        <label>Collect Goal Action Plan Template Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSelectedTemplateIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varCurrentTemplateId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Care_Plan_Goals</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_Template_Already_Collected</name>
        <label>Mark Template Already Collected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varIsTemplateCollected</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Check_Action_Plan_Template_Collected</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Mark_Version_Template_Resolved</name>
        <label>Mark Version Template Resolved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varIsVersionTemplateResolved</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Check_Version_Template_Resolved</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_Version_Resolved_Flag</name>
        <label>Reset Version Resolved Flag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varIsVersionTemplateResolved</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Check_Version_Template_Resolved</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Created_Care_Plan_Id</name>
        <label>Set Created Care Plan Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>createdCarePlanId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Care_Plan.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Care_Plan_Goals</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Error_Fault</name>
        <label>Set Error Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Error_Invalid_Dates</name>
        <label>Set Error Invalid Dates</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The End Date must be later than the Start Date.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Error_No_Contact</name>
        <label>Set Error No Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>errorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>This Case does not have a Contact. Add the student Contact to the Case and run this action again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Success</name>
        <label>Set Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Action_Plan_Template_Collected_Check</name>
        <label>Action Plan Template Collected Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Collect_Goal_Action_Plan_Template_Id</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Collected</defaultConnectorLabel>
        <rules>
            <name>Already_Collected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsTemplateCollected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Care_Plan_Goals</targetReference>
            </connector>
            <label>Already Collected</label>
        </rules>
    </decisions>
    <decisions>
        <name>Action_Plan_Template_Id_Matches</name>
        <label>Action Plan Template Id Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Check_Action_Plan_Template_Collected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Template</defaultConnectorLabel>
        <rules>
            <name>Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Check_Action_Plan_Template_Collected</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varCurrentTemplateId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Template_Already_Collected</targetReference>
            </connector>
            <label>Matched</label>
        </rules>
    </decisions>
    <decisions>
        <name>Action_Plans_Exist</name>
        <label>Action Plans Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Action_Plans_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varActionPlansToCreate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Create_Action_Plans</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_Has_Contact</name>
        <label>Case Has Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Error_No_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Dates_Are_Valid</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_Participant_Exists</name>
        <label>Case Participant Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Case_Participant</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Participant_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Participant.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Care_Plan_Goals</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Dates_Are_Valid</name>
        <label>Dates Are Valid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Error_Invalid_Dates</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid</defaultConnectorLabel>
        <rules>
            <name>Valid_Dates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>endDate</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>startDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_Participant</targetReference>
            </connector>
            <label>Valid</label>
        </rules>
    </decisions>
    <decisions>
        <name>Goal_Assignments_Exist</name>
        <label>Goal Assignments Exist</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Templates_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Assignments_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varGoalAssignmentsToCreate</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Create_Goal_Assignments</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Goal_Has_Action_Plan_Template</name>
        <label>Goal Has Action Plan Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Care_Plan_Goals</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Template</defaultConnectorLabel>
        <rules>
            <name>Has_Template</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCurrentTemplateId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Check_Action_Plan_Template_Collected</targetReference>
            </connector>
            <label>Has Template</label>
        </rules>
    </decisions>
    <decisions>
        <name>Templates_Found</name>
        <label>Templates Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Templates_Collected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varSelectedTemplateIds</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Action_Plan_Versions</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Version_Template_Id_Matches</name>
        <label>Version Template Id Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Check_Version_Template_Resolved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Template</defaultConnectorLabel>
        <rules>
            <name>Version_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Check_Version_Template_Resolved</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Resolve_Action_Plan_Versions.ActionPlanTemplateId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Version_Template_Resolved</targetReference>
            </connector>
            <label>Matched</label>
        </rules>
    </decisions>
    <decisions>
        <name>Version_Template_Resolved_Check</name>
        <label>Version Template Resolved Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Build_Action_Plan</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Resolved</defaultConnectorLabel>
        <rules>
            <name>Already_Resolved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsVersionTemplateResolved</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Resolve_Action_Plan_Versions</targetReference>
            </connector>
            <label>Already Resolved</label>
        </rules>
    </decisions>
    <description>Creates the Care Plan, one Goal Assignment per Care Plan Template Goal, and one Action Plan per distinct Action Plan Template configured on those Goals. Every query and DML statement runs outside all loops so the flow stays bulk safe when called per record from a record-triggered flow. Reports outcome through isSuccess and errorMessage instead of a screen.</description>
    <environments>Default</environments>
    <formulas>
        <name>Action_Plan_End_Date</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!endDate})</expression>
    </formulas>
    <formulas>
        <name>Action_Plan_Name</name>
        <dataType>String</dataType>
        <expression>{!carePlanName} &amp; &quot; - &quot; &amp; {!Loop_Resolve_Action_Plan_Versions.ActionPlanTemplate.Name} &amp; &quot; Action Plan&quot;</expression>
    </formulas>
    <formulas>
        <name>Action_Plan_Start_Date</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!startDate})</expression>
    </formulas>
    <interviewLabel>Create Care Plan Records {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Care Plan Records</label>
    <loops>
        <name>Loop_Care_Plan_Goals</name>
        <label>Loop Care Plan Goals</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Care_Plan_Goals</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Goal_Assignment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Goal_Assignments_Exist</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Check_Action_Plan_Template_Collected</name>
        <label>Loop Check Action Plan Template Collected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varSelectedTemplateIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Action_Plan_Template_Id_Matches</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Action_Plan_Template_Collected_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Check_Version_Template_Resolved</name>
        <label>Loop Check Version Template Resolved</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varResolvedTemplateIds</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Version_Template_Id_Matches</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Version_Template_Resolved_Check</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Resolve_Action_Plan_Versions</name>
        <label>Loop Resolve Action Plan Versions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Action_Plan_Versions</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Reset_Version_Resolved_Flag</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Action_Plans_Exist</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Bulk_Create_Action_Plans</name>
        <label>Bulk Create Action Plans</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error_Fault</targetReference>
        </faultConnector>
        <inputReference>varActionPlansToCreate</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Bulk_Create_Goal_Assignments</name>
        <label>Bulk Create Goal Assignments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Templates_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Error_Fault</targetReference>
        </faultConnector>
        <inputReference>varGoalAssignmentsToCreate</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_Care_Plan</name>
